<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".request_meeting">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="35dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/textView26"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/a1"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/labelFaculty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Faculty"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#202124" />

        <TextView
            android:id="@+id/facultyNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Dr. Sharma"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#202124" />

        <TextView
            android:id="@+id/facultyDepartmentTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Computer Engineering"
            android:textSize="14sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/labelDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Meeting Date"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#202124" />

        <TextView
            android:id="@+id/dateTextView"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:text="@string/a5"
            android:textColor="#111827"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/labelTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Meeting Time"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#202124" />

        <Button
            android:id="@+id/buttonMeetingTime"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Select Meeting Time"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/labelDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Message / Description (Optional)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#202124" />

        <EditText
            android:id="@+id/editTextText18"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/editbox_background"
            android:gravity="top|start"
            android:hint="@string/a4"
            android:inputType="textMultiLine"
            android:maxLength="250"
            android:padding="14dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textViewOptional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="You can briefly mention the reason for the meeting. This is optional."
            android:textSize="12sp"
            android:textColor="#777777" />

        <TextView
            android:id="@+id/textViewRequestInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:padding="14dp"
            android:text="Your meeting request will be sent to the faculty for approval."
            android:textSize="13sp"
            android:textColor="#555B65" />

        <Button
            android:id="@+id/button9"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="25dp"
            android:text="@string/a3"
            android:textAllCaps="false"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>