<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#F7F8FA"
    tools:context=".MainActivity6">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="30dp"
        android:paddingBottom="35dp">

        <!-- ============================================== -->
        <!-- HEADING -->
        <!-- ============================================== -->

        <TextView
            android:id="@+id/textViewHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/where_is_my_teacher"
            android:textColor="#202124"
            android:textSize="24sp"
            android:textStyle="bold" />


        <!-- ============================================== -->
        <!-- SEARCH -->
        <!-- ============================================== -->

        <TextView
            android:id="@+id/textViewSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/search_label"
            android:textColor="#202124"
            android:textSize="15sp"
            android:textStyle="bold" />

        <AutoCompleteTextView
            android:id="@+id/editTextSearchTeacher"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/editbox_background"
            android:completionThreshold="1"
            android:hint="@string/search_hint"
            android:inputType="text"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:singleLine="true"
            android:textColor="#202124"
            android:textColorHint="#777777"
            android:textSize="14sp" />


        <!-- ============================================== -->
        <!-- TEACHER INFORMATION -->
        <!-- ============================================== -->

        <LinearLayout
            android:id="@+id/teacherContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textViewTeacherName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/teacher_name"
                android:textColor="#202124"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewTeacherDepartment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/department"
                android:textColor="#666666"
                android:textSize="14sp" />


            <!-- ========================================== -->
            <!-- FULL WEEK -->
            <!-- ========================================== -->

            <Button
                android:id="@+id/availabilityButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:text="@string/check_full_week_availability"
                android:textAllCaps="false"
                android:textSize="13sp" />


            <!-- ========================================== -->
            <!-- CURRENT STATUS -->
            <!-- ========================================== -->

            <TextView
                android:id="@+id/textViewCurrently"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/available_today"
                android:textColor="#202124"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/currentStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/textViewCurrentStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/loading"
                    android:textColor="#202124"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/loading"
                    android:textColor="#555B65"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textViewCurrentTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/loading"
                    android:textColor="#555B65"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- ========================================== -->
            <!-- TODAY -->
            <!-- ========================================== -->

            <TextView
                android:id="@+id/textViewToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/today"
                android:textColor="#202124"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/teacherScheduleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/scheduleLoadingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/loading"
                    android:textColor="#666666"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- ========================================== -->
            <!-- REQUEST MEETING -->
            <!-- ========================================== -->

            <Button
                android:id="@+id/buttonRequestMeeting"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="30dp"
                android:text="@string/request_meeting"
                android:textAllCaps="false"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>