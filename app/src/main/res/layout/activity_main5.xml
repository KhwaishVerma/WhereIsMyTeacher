<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="35dp"
        android:paddingBottom="35dp">

        <!-- ============================================== -->
        <!-- STUDENT PROFILE -->
        <!-- ============================================== -->

        <TextView
            android:id="@+id/textViewWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/textViewDepartment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textSize="17sp"
            android:layout_marginBottom="30dp" />


        <!-- ============================================== -->
        <!-- QUICK ACCESS -->
        <!-- ============================================== -->

        <TextView
            android:id="@+id/textViewQuick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quick_access"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/buttonFindTeacher"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:text="@string/find_teacher_button"
                android:textSize="14sp" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/buttonMyRequests"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:text="@string/my_requests"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ============================================== -->
        <!-- FAVOURITE TEACHERS -->
        <!-- ============================================== -->

        <TextView
            android:id="@+id/textViewFavourite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/favourite_teachers"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="15dp" />


        <!-- ============================================== -->
        <!-- TEACHER CARD 1 -->
        <!-- ============================================== -->

        <LinearLayout
            android:id="@+id/teacherCard1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/textViewTeacher1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/teacher1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/textViewSubject1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subject1"
                android:textSize="15sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/textViewRoom1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/room1"
                android:textSize="15sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/textViewAvailable1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/available1"
                android:textSize="15sp" />

        </LinearLayout>


        <!-- ============================================== -->
        <!-- TEACHER CARD 2 -->
        <!-- ============================================== -->

        <LinearLayout
            android:id="@+id/teacherCard2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textViewTeacher2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/teacher2"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/textViewSubject2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subject2"
                android:textSize="15sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/textViewLeave2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/leave2"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>