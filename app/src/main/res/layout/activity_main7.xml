<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".MainActivity7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Back -->

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ Back"
            android:textColor="#111111"
            android:textSize="20sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp" />


        <!-- Teacher Name -->

        <TextView
            android:id="@+id/textViewTeacherName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Teacher"
            android:textColor="#111111"
            android:textSize="27sp"
            android:textStyle="bold" />


        <!-- Department -->


        <!-- Divider -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#D0D0D0" />


        <!-- Title -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Weekly Availability"
            android:textColor="#111111"
            android:textSize="23sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="View this teacher's complete weekly schedule."
            android:textColor="#666666"
            android:textSize="14sp" />


        <!-- Loading -->

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Loading timetable..."
            android:textColor="#666666"
            android:textSize="14sp" />


        <!-- ============================== -->
        <!-- MONDAY -->
        <!-- ============================== -->

        <TextView
            android:id="@+id/mondayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Monday"
            android:textColor="#111111"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/mondayAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#FFFFFF"
            android:elevation="2dp" />


        <!-- ============================== -->
        <!-- TUESDAY -->
        <!-- ============================== -->

        <TextView
            android:id="@+id/tuesdayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Tuesday"
            android:textColor="#111111"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/tuesdayAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#FFFFFF"
            android:elevation="2dp" />


        <!-- ============================== -->
        <!-- WEDNESDAY -->
        <!-- ============================== -->

        <TextView
            android:id="@+id/wednesdayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Wednesday"
            android:textColor="#111111"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/wednesdayAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#FFFFFF"
            android:elevation="2dp" />


        <!-- ============================== -->
        <!-- THURSDAY -->
        <!-- ============================== -->

        <TextView
            android:id="@+id/thursdayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Thursday"
            android:textColor="#111111"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/thursdayAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#FFFFFF"
            android:elevation="2dp" />


        <!-- ============================== -->
        <!-- FRIDAY -->
        <!-- ============================== -->

        <TextView
            android:id="@+id/fridayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Friday"
            android:textColor="#111111"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/fridayAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#FFFFFF"
            android:elevation="2dp" />

    </LinearLayout>

</ScrollView>