<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/timetable_importer"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"/>


        <!-- FILE CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_timetable"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111827"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/supported_formats"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginTop="4dp"/>

            <Button
                android:id="@+id/uploadButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/select_timetable_file"
                android:textAllCaps="false"/>

            <TextView
                android:id="@+id/fileNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_file_selected"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

        </LinearLayout>


        <!-- FACULTY SHEET -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/selected_faculty_sheet"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#374151"/>

            <TextView
                android:id="@+id/selectedSheetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_sheet_selected"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginTop="5dp"/>

            <TextView
                android:id="@+id/facultyNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/faculty_name_not_available"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginTop="3dp"/>

        </LinearLayout>


        <!-- IMPORT -->

        <Button
            android:id="@+id/ocrButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/import_timetable"
            android:textAllCaps="false"
            android:enabled="false"/>


        <!-- PROGRESS -->

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>


        <!-- STATUS -->

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_file_to_begin"
            android:textSize="13sp"
            android:textColor="#374151"
            android:gravity="center"
            android:padding="10dp"/>


        <!-- PARSED PREVIEW -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/timetable_preview"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D1D5DB"
            android:scrollbars="horizontal">

            <TableLayout
                android:id="@+id/parsedTable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"/>

        </HorizontalScrollView>

    </LinearLayout>

</ScrollView>