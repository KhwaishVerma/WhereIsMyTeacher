<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WhereIsMyTeacher"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Timetable Importer"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"/>


        <!-- FILE CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Import Timetable"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111827"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Supported formats: CSV, XLS, XLSX"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginTop="4dp"/>

            <Button
                android:id="@+id/uploadButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Select Timetable File"
                android:textAllCaps="false"/>

            <TextView
                android:id="@+id/fileNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No file selected"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

        </LinearLayout>


        <!-- PROCESS -->

        <Button
            android:id="@+id/ocrButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Import Timetable"
            android:textAllCaps="false"
            android:enabled="false"/>


        <!-- PROGRESS -->

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>


        <!-- STATUS -->

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a timetable file to begin."
            android:textSize="13sp"
            android:textColor="#374151"
            android:gravity="center"
            android:padding="10dp"/>


        <!-- TABLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Timetable Preview"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D1D5DB"
            android:scrollbars="horizontal">

            <TableLayout
                android:id="@+id/ocrTable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"/>

        </HorizontalScrollView>


        <!-- JSON -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generated JSON"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/jsonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JSON output will appear here..."
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="#1F2937"
            android:background="#FFFFFF"
            android:padding="14dp"/>


        <!-- DOWNLOAD -->

        <Button
            android:id="@+id/downloadButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Export JSON"
            android:textAllCaps="false"
            android:enabled="false"/>

    </LinearLayout>

</ScrollView>